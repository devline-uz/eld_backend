# OneBook ELD — production env (tz.md §22.1). Copy to .env.production and
# fill from the server secrets folder. Variable set is authoritative in
# src/core/config/env.schema.ts.
NODE_ENV=production
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173
# CODE-004 - reverse proxies allowed to set X-Forwarded-For (real client IP for rate limits,
# audit log, sessions). loopback = Caddy on the same host (docker/caddy/Caddyfile). true and
# hop counts are refused (spoofable). docker-compose.yml sets loopback,uniquelocal for its api.
TRUST_PROXY=loopback

DATABASE_URL=postgresql://eld_prod:CHANGE_ME@127.0.0.1:55432/onebook_eld?connection_limit=20

REDIS_URL=redis://:CHANGE_ME@127.0.0.1:63791
REDIS_DB=0
QUEUE_PREFIX=onebook

S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=onebook-prod
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=
S3_PRESIGN_TTL_SEC=900

# CODE-001 - REQUIRED. With NODE_ENV=production the app refuses to start on a missing, default,
# placeholder (CHANGE_ME...) or short (<32 chars) value. Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_32_CHARS_MINIMUM_XXXXXXXX
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# MG-32 — seconds a just-rotated refresh token may be replayed and get the same pair back (0 = off)
REFRESH_REUSE_GRACE_SECONDS=60
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=

# B-25 - only toggles back-office PASSWORD login/reset (dev = allowed, production = Google Sign-In
# only). It does not enable any dev shortcut: DEV_ECHO_SECRETS / virtual ELD already follow NODE_ENV.
# Keep dev until Google Sign-In (FIREBASE_*) works for every back-office user, then switch.
AUTH_MODE=dev
# B-093 - ignored when NODE_ENV=production; one-time secrets are never echoed.
DEV_ECHO_SECRETS=false

# CODE-001 - REQUIRED. AES-256-GCM key for Integration.config secrets: base64 of exactly 32 bytes.
# Refused at startup with NODE_ENV=production when missing/default/placeholder. Generate:
# openssl rand -base64 32   (changing it later makes already-stored integration secrets unreadable)
INTEGRATION_ENCRYPTION_KEY=CHANGE_ME

# Transactional email (user invites). Without SMTP_HOST invites are created but NOT emailed.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=<gmail address>,
# SMTP_PASS=<16-char App Password — needs 2-Step Verification>, MAIL_FROM must use that same address.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OneBook ELD <no-reply@stackyard.uz>
# Web panel origin used for the "Sign in" link in invite emails
WEB_APP_URL=https://eldadmin.stackyard.uz
# Driver email change: confirm-link lifetime, and the post-change hold (hours) during which
# the old address can revert it and no reset code is mailed to the new address.
# Hold: integer hours, 1..720 (0 is rejected at startup — the hold cannot be disabled).
DRIVER_EMAIL_CHANGE_TTL=24h
DRIVER_EMAIL_CHANGE_HOLD_HOURS=48
# Web-user email change: confirm-link lifetime, and the post-change hold (hours) during which
# the old address can revert it and no reset code is mailed to the new address (admins are notified).
# Hold: integer hours, 1..720 (0 is rejected at startup — the hold cannot be disabled).
USER_EMAIL_CHANGE_TTL=24h
USER_EMAIL_CHANGE_HOLD_HOURS=48

LOG_LEVEL=info
LOG_PRETTY=false
SENTRY_DSN=
# D-158 - POST /client-errors forwards admin/mobile errors to the local error bot; empty secret = drop.
ERROR_REPORT_URL=http://127.0.0.1:8790/report
ERROR_REPORT_SECRET=
METRICS_ENABLED=true
# CODE-082 — /metrics and /health/deep answer private/loopback callers, or `Authorization: Bearer <token>`
# when this is set (>= 24 chars, e.g. openssl rand -base64 32). Empty = network rule only.
METRICS_TOKEN=

SEED_ANCHOR_DATE=
SWAGGER_ENABLED=false
SHUTDOWN_TIMEOUT_MS=15000

# pt30_pt40/tz.md §9.2 — Virtual ELD (PT Emulator) must stay off in production.
VIRTUAL_ELD_ALLOWED=false
