# --- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173

# --- database (TZ §22.3) -----------------------------------------------------
# Dev MUST use onebook_eld_dev; prod MUST use onebook_eld with user eld_prod.
# db-guard.ts rejects any other combination at bootstrap and cannot be disabled.
DATABASE_URL=postgresql://eld_dev:changeme@localhost:5432/onebook_eld_dev?connection_limit=20

# --- redis / BullMQ (dev = DB 1, prod = DB 0) --------------------------------
REDIS_URL=redis://localhost:6379
REDIS_DB=1
QUEUE_PREFIX=onebook

# --- storage (MinIO in dev) --------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=onebook-eld
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=
S3_PRESIGN_TTL_SEC=900

# --- auth --------------------------------------------------------------------
JWT_SECRET=dev-only-secret-change-me-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
FIREBASE_PROJECT_ID=
# Never commit the service-account file (TZ §6.5) — point at the server secrets dir.
FIREBASE_CREDENTIALS_FILE=

# --- observability -----------------------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY=true
SENTRY_DSN=
METRICS_ENABLED=true

# --- misc --------------------------------------------------------------------
SWAGGER_ENABLED=true
SHUTDOWN_TIMEOUT_MS=15000
# SEED_ANCHOR_DATE=2025-09-10T15:41:00-04:00
