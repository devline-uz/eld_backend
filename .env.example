# --- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173
# CODE-004 - proxies trusted for X-Forwarded-For (loopback | linklocal | uniquelocal | IP | CIDR, comma-separated; false = none).
TRUST_PROXY=loopback

# --- database (TZ §22.3) -----------------------------------------------------
# Dev MUST use onebook_eld_dev; prod MUST use onebook_eld with user eld_prod.
# db-guard.ts rejects any other combination at bootstrap and cannot be disabled.
# connection_limit=4 for dev, NOT the tz.md §19 blanket "20" — eld_dev's role is hard-capped
# at CONNECTION LIMIT 10 (§22.3) and is shared by api-dev plus test:integration/test:e2e
# runs at the same time; see decisions.md D-041 / bugs.md B-038. Prod uses 20 (see
# .env.production.example) because api(20)+worker(20)=eld_prod's CONNECTION LIMIT 40 exactly.
DATABASE_URL=postgresql://eld_dev:changeme@localhost:5432/onebook_eld_dev?connection_limit=4

# --- redis / BullMQ (dev = DB 1, prod = DB 0) --------------------------------
REDIS_URL=redis://localhost:6379
REDIS_DB=1
QUEUE_PREFIX=onebook

# --- storage (MinIO in dev) --------------------------------------------------
S3_ENDPOINT=http://localhost:9000
# Optional. Public origin baked into presigned URLs (phones/browsers cannot reach the internal endpoint).
# Path-style; proxy must forward /<bucket>/ to MinIO preserving Host. Unset = presign with S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=https://eldapi.example.com
# Voice-message transcoding (WebM/Ogg -> M4A). Default: ffmpeg from PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
S3_REGION=us-east-1
S3_BUCKET=onebook-eld
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=
S3_PRESIGN_TTL_SEC=900

# --- auth --------------------------------------------------------------------
JWT_SECRET=dev-only-secret-change-me-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# MG-32 — seconds a just-rotated refresh token may be replayed and get the same pair back (0 = off)
REFRESH_REUSE_GRACE_SECONDS=60
FIREBASE_PROJECT_ID=
# Never commit the service-account file (TZ §6.5) — point at the server secrets dir.
FIREBASE_CREDENTIALS_FILE=

# B-25 - dev keeps password login working; production blocks POST /auth/login (403 PASSWORD_LOGIN_DISABLED)
AUTH_MODE=dev
# B-093 - echo reset/verify tokens and one-time codes in API responses (never in production). Keep false on any shared/public host.
DEV_ECHO_SECRETS=false

# --- transactional email (user invites) ----------------------------------------
# Leave SMTP_HOST empty to log instead of sending. Does not enable eRODS email transfer.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OneBook ELD <no-reply@example.com>
# Web panel origin used for the "Sign in" link in invite emails
WEB_APP_URL=http://localhost:5173
# Driver email change: confirm-link lifetime, and the post-change hold (hours) during which
# the old address can revert it and no reset code is mailed to the new address.
# Hold: integer hours, 1..720 (0 is rejected at startup — the hold cannot be disabled).
DRIVER_EMAIL_CHANGE_TTL=24h
DRIVER_EMAIL_CHANGE_HOLD_HOURS=48
# Web-user email change: confirm-link lifetime, and the post-change hold (hours) during which
# the old address can revert it and no reset code is mailed to the new address (admins are notified).
# Hold: integer hours, 1..720 (0 is rejected at startup — the hold cannot be disabled).
USER_EMAIL_CHANGE_TTL=24h
USER_EMAIL_CHANGE_HOLD_HOURS=48

# --- observability -----------------------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY=true
SENTRY_DSN=
# D-158 - POST /client-errors forwards admin/mobile errors to the local error bot; empty secret = drop.
ERROR_REPORT_URL=http://127.0.0.1:8790/report
ERROR_REPORT_SECRET=
METRICS_ENABLED=true
# CODE-082 — /metrics and /health/deep answer private/loopback callers, or `Authorization: Bearer <token>`
# when this is set (>= 24 chars, e.g. openssl rand -base64 32). Empty = network rule only.
METRICS_TOKEN=

# --- mobile app update (bootstrap.appUpdate, MB-19) ---------------------------
# MOBILE_APP_LATEST_VERSION=2.3.0
# MOBILE_APP_MIN_VERSION=2.0.0
# MOBILE_APP_RELEASE_NOTES=Bug fixes and stability improvements.
# MOBILE_APP_STORE_URL_IOS=https://apps.apple.com/app/id0000000000
# MOBILE_APP_STORE_URL_ANDROID=https://play.google.com/store/apps/details?id=com.onebook.eld

# --- GET /mobile/app-config (public, MR-7) — unset/blank -> null ------------------
# MOBILE_MIN_SUPPORTED_VERSION=   (falls back to MOBILE_APP_MIN_VERSION)
# MOBILE_LATEST_VERSION=          (falls back to MOBILE_APP_LATEST_VERSION)
# MOBILE_STORE_URL=
# MOBILE_USER_MANUAL_URL=
# MOBILE_PRIVACY_URL=
# MOBILE_TERMS_URL=
# MOBILE_LEGAL_VERSION=
# PT30 firmware gate: leave UNSET until the vendor publishes versions (never invent one).
# MOBILE_MIN_PT30_FIRMWARE=
# MOBILE_RECOMMENDED_PT30_FIRMWARE=

# --- misc --------------------------------------------------------------------
SWAGGER_ENABLED=true
SHUTDOWN_TIMEOUT_MS=15000
# SEED_ANCHOR_DATE=2025-09-10T15:41:00-04:00

# pt30_pt40/tz.md §9.2 — Virtual ELD (PT Emulator) test mode. Unset = true unless NODE_ENV=production.
# VIRTUAL_ELD_ALLOWED=true
