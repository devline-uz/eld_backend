-- Template — NOT executed automatically (note the .sql.template extension,
-- Postgres only runs *.sql/*.sh from docker-entrypoint-initdb.d).
--
-- Real passwords live in the server secrets folder, never in the repo or an
-- image layer. At deploy time, render this template (envsubst or similar)
-- with ELD_PROD_DB_PASSWORD / ELD_DEV_DB_PASSWORD from the secrets folder
-- and run it once via:
--   docker exec -i onebook-postgres psql -U postgres -f - < rendered.sql
--
-- This overwrites the placeholder passwords set by 01_create_roles_and_dbs.sql.

ALTER ROLE eld_prod WITH PASSWORD '${ELD_PROD_DB_PASSWORD}';
ALTER ROLE eld_dev  WITH PASSWORD '${ELD_DEV_DB_PASSWORD}';
