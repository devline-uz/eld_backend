# OneBook ELD — reverse proxy routes (tz.md §22.2).
# Caddy is already the proxy on this box; this file only adds the two
# API routes (prod :3000, dev :3001). Fill in real hostnames per server.
#
# Install: copy the relevant `handle`/site block into the box's live
# Caddyfile (or `import` this file from it) and reload with
# `caddy reload --config /etc/caddy/Caddyfile`.

# --- Production API --------------------------------------------------
api.onebook-eld.example.com {
	encode gzip

	reverse_proxy /* localhost:3000 {
		header_up X-Forwarded-Proto {scheme}
	}

	# CODE-082 — /metrics and /health/deep are operator data. Prometheus scrapes the API
	# directly on the docker network (docker/prometheus/prometheus.yml), never through this
	# public host, so they are not published here at all. The app refuses them too
	# (InternalProbeGuard: private/loopback caller or METRICS_TOKEN). /health/live and
	# /health/ready stay reachable for external uptime checks.
	@internal_probes path /metrics /health/deep
	respond @internal_probes 404

	log {
		output file /var/log/caddy/onebook-api-prod.log
		format json
	}
}

# --- Development API (watch mode) -------------------------------------
api-dev.onebook-eld.example.com {
	encode gzip

	@internal_probes path /metrics /health/deep
	respond @internal_probes 404

	reverse_proxy /* localhost:3001 {
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output file /var/log/caddy/onebook-api-dev.log
		format json
	}
}
