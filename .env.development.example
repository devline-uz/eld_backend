# OneBook ELD — development env (tz.md §22.1). Copy to .env.development and
# fill from the server secrets folder. Variable set is authoritative in
# src/core/config/env.schema.ts.
NODE_ENV=development
PORT=3001
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173

# connection_limit=4, deliberately below tz.md §19's blanket "connection_limit=20" — the
# hard `eld_dev` role cap is CONNECTION LIMIT 10 (§22.3 resource fencing) and this file is
# also loaded by test:integration/test:e2e (test/setup/integration.setup.ts) while api-dev
# keeps running, so it is a *per-process* budget shared by several concurrent consumers on
# this box, not a single pool. See decisions.md D-041 / bugs.md B-038 for the arithmetic.
DATABASE_URL=postgresql://eld_dev:CHANGE_ME@127.0.0.1:55432/onebook_eld_dev?connection_limit=4
# Optional — TZ §5.5/§18/§23 AuditLog 24-month purge (retention.processor). Connection string
# for the narrowly-scoped `eld_retention_svc` role (SELECT+DELETE on AuditLog only), NOT the
# app role above. Bootstrap once per environment: `scripts/bootstrap-retention-role.sql` (run
# by an operator with a superuser connection — see decisions.md D-040). Left unset here on
# purpose: until it is bootstrapped, retention.processor still archives+drops EldEvent
# partitions but safely skips the AuditLog purge (logs a warning) instead of ever falling back
# to DATABASE_URL, which has DELETE revoked on AuditLog (B-009).
# RETENTION_DATABASE_URL=postgresql://eld_retention_svc:CHANGE_ME@127.0.0.1:55432/onebook_eld_dev?connection_limit=2

REDIS_URL=redis://:CHANGE_ME@127.0.0.1:63791
REDIS_DB=1
QUEUE_PREFIX=onebook

S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=onebook-dev
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=
S3_PRESIGN_TTL_SEC=900

JWT_SECRET=CHANGE_ME_32_CHARS_MINIMUM_XXXXXXXX
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=

# B-25 - dev keeps password login working; production blocks POST /auth/login (403 PASSWORD_LOGIN_DISABLED)
AUTH_MODE=dev
# B-093 - set true only on a private workstation to see reset/verify tokens without a mailer; keep false on shared/public hosts.
DEV_ECHO_SECRETS=false

LOG_LEVEL=debug
LOG_PRETTY=true
SENTRY_DSN=
METRICS_ENABLED=true

SEED_ANCHOR_DATE=
SWAGGER_ENABLED=true
SHUTDOWN_TIMEOUT_MS=15000

# Dev only — never set in production, see .env.production(.example).
GEOCODER_URL=https://nominatim.openstreetmap.org
